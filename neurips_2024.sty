\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2024}[2024/01/01 NeurIPS 2024 Style]

\RequirePackage[verbose=true,letterpaper]{geometry}
\AtBeginDocument{
  \newgeometry{
    textheight=9in,
    textwidth=5.5in,
    top=1in,
    headheight=12pt,
    headsep=25pt,
    footskip=30pt
  }
}

\widowpenalty=10000
\clubpenalty=10000
\flushbottom
\sloppy

\RequirePackage{natbib}
\bibliographystyle{abbrvnat}
\setcitestyle{authoryear,round,citesep={;},aysep={,},yysep={;}}

\RequirePackage{fancyhdr}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\pagestyle{fancy}

\RequirePackage[breaklinks=true,colorlinks,citecolor=blue,urlcolor=blue,linkcolor=blue]{hyperref}

% Title
\def\@maketitle{%
  \vbox{%
    \hsize\textwidth
    \linewidth\hsize
    \centering
    {\LARGE\bfseries \@title\par}
    \vskip 0.3in
    {\large \@author\par}
    \vskip 0.3in
    {\large \@date\par}
  }
  \vskip 0.3in
}

% Abstract
\renewenvironment{abstract}%
{%
  \centerline{\large\bfseries Abstract}
  \vspace{0.5ex}
  \begin{quote}
}
{
  \par
  \end{quote}
  \vskip 1ex
}

% Section formatting
\RequirePackage[compact]{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{1em}{}
